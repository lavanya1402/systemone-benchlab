# Copy to .env (never commit .env). On Streamlit Cloud, add these to Secrets.

# Jev — direct decision model (TypeSafe System One API)
TYPESAFE_API_KEY=your-typesafe-api-key
# Optional: pinned model version (default jev-1.13.0)
# TYPESAFE_MODEL=jev-1.13.0

# Optional: Jev Router via OpenRouter (historical comparison only)
# OPENROUTER_API_KEY=your-openrouter-api-key
# JEV_MODEL=typesafe/jev-router
